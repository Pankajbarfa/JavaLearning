import java.util.Scanner;

public class CgTest {
    public static void main(String[] args) {
        Scanner scanner = new Scanner(System.in);

        System.out.print("Enter the size of the array: ");
        int arr_length = scanner.nextInt();

        int[] arr = new int[arr_length];

        System.out.println("Enter the elements of the array:");
        for (int i = 0; i < arr_length; i++) {
            arr[i] = scanner.nextInt();
        }

        int largestLCM = findLargestLCM(arr);

        System.out.println("Largest element in set S: " + largestLCM);

        scanner.close();
    }

    private static int findLargestLCM(int[] arr) {
        int largestLCM = 0;

        for (int i = 0; i < arr.length - 1; i++) {
            int currentLCM = findLCM(arr[i], arr[i + 1]);
            largestLCM = Math.max(largestLCM, currentLCM);
        }

        return largestLCM;
    }

    private static int findLCM(int a, int b) {
        return (a * b) / findGCD(a, b);
    }

    private static int findGCD(int a, int b) {
        while (b != 0) {
            int temp = b;
            b = a % b;
            a = temp;
        }
        return a;
    }
}
